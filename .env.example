# Copy to .env and fill in. NEVER commit the real .env — this repo is public.

# --- Cloudflare D1 (drizzle-kit only; the app itself uses the DB binding) ---
# Account ID: Cloudflare dashboard -> Workers & Pages -> right sidebar
# Database ID: output of `pnpm exec wrangler d1 create japanese-quiz`
# D1 token: My Profile -> API Tokens, scoped to D1:Edit
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

# --- App secrets ---
# Random 32+ byte string. Generate: openssl rand -base64 32
# Signs the player session cookie and the admin cookie.
AUTH_SECRET=""

# Shared password for the /admin question editor.
ADMIN_PASSWORD=""
